diff --git a/bsd/dev/sweet_rpmh_arc.c b/bsd/dev/sweet_rpmh_arc.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sweet_rpmh_arc.c
@@ -0,0 +1,54 @@
+/*
+ * SWEET: translate RPMh ARC command-DB level maps into safe selectors.
+ * The raw command DB contains little-endian u16 levels; ARC TCS payloads
+ * carry an index, not the consumer voltage level.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/errno.h>
+#include <stdint.h>
+#include <stdbool.h>
+
+int
+sweet_rpmh_arc_choose_level(const uint16_t *raw, unsigned count, uint32_t requested,
+    uint32_t *selector)
+{
+	if (!raw || !selector || count == 0 || count > 16 || requested == 0) {
+		return EINVAL;
+	}
+
+	unsigned live = count;
+	for (unsigned i = 1; i < count; ++i) {
+		if (raw[i] == 0) {
+			for (unsigned j = i; j < count; ++j) {
+				if (raw[j] != 0) {
+					return EINVAL;
+				}
+			}
+			live = i;
+			break;
+		}
+		if (raw[i] <= raw[i - 1]) {
+			return EINVAL;
+		}
+	}
+
+	bool found = false;
+	uint32_t best = 0;
+	unsigned best_index = 0;
+	for (unsigned i = 0; i < live; ++i) {
+		/* Xiaomi's regulator driver adds LEVEL_OFFSET (1) to each u16. */
+		uint32_t level = (uint32_t)raw[i] + 1u;
+		if (level >= requested && (!found || level < best)) {
+			found = true;
+			best = level;
+			best_index = i;
+		}
+	}
+	if (!found) {
+		return ERANGE;
+	}
+	*selector = best_index;
+	return 0;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_rpmh.c b/bsd/dev/sweet_rpmh.c
--- a/bsd/dev/sweet_rpmh.c
+++ b/bsd/dev/sweet_rpmh.c
@@ -43,8 +43,12 @@
 #define RH_DB_HEADER    144u
 #define RH_DB_ENTRY     24u
 #define RH_DB_MAX       0x100000u /* policy bound, not a DT size */
+#define RH_ARC          3u
 #define RH_VRM          4u
 #define RH_TIMEOUT_US   100000u
+
+extern int sweet_rpmh_arc_choose_level(const uint16_t *, unsigned,
+    uint32_t, uint32_t *);
 
 static vm_offset_t rh_rsc, rh_tcs, rh_dict, rh_db;
 static uint32_t rh_db_size;
@@ -205,6 +209,72 @@
 	return 0;
 }
 
+/* ARC resources encode a selector table in CMD DB AUX data. */
+static int
+rh_lookup_arc(const char *res, uint32_t requested, uint32_t *address,
+    uint32_t *selector)
+{
+	uint32_t key[2] = {0, 0};
+	for (unsigned i = 0; i < 8 && res[i]; ++i) {
+		key[i / 4] |= (uint32_t)(uint8_t)res[i] << (8u * (i % 4));
+	}
+	unsigned matches = 0;
+	for (unsigned i = 0; i < 8; ++i) {
+		uint32_t h = 8u + 16u * i;
+		unsigned slave = rh_db16(h);
+		if (!slave) {
+			break;
+		}
+		uint32_t entries = RH_DB_HEADER + rh_db16(h + 2);
+		uint32_t aux = RH_DB_HEADER + rh_db16(h + 4);
+		unsigned count = rh_db16(h + 6);
+		if (slave < RH_ARC || slave > RH_VRM || (entries & 3u) ||
+		    !rh_range(entries, count * RH_DB_ENTRY) || !rh_range(aux, 0)) {
+			printf("SWEET RPMH: malformed ARC cmd-db slave header %u\n", i);
+			return EINVAL;
+		}
+		for (unsigned j = 0; j < count; ++j) {
+			uint32_t e = entries + RH_DB_ENTRY * j;
+			if (rh_read(rh_db, e) != key[0] || rh_read(rh_db, e + 4) != key[1]) {
+				continue;
+			}
+			if (++matches != 1) {
+				printf("SWEET RPMH: duplicate ARC resource %s\n", res);
+				return EEXIST;
+			}
+			uint32_t addr = rh_read(rh_db, e + 16);
+			unsigned bytes = rh_db16(e + 20);
+			uint32_t map = aux + rh_db16(e + 22);
+			if (slave != RH_ARC || (addr >> 16) != RH_ARC || (addr & 15u) ||
+			    bytes < 2 || bytes > 32 || (bytes & 1u) ||
+			    !rh_range(map, bytes)) {
+				printf("SWEET RPMH: invalid ARC entry for %s\n", res);
+				return EINVAL;
+			}
+			uint16_t levels[16];
+			unsigned nlevels = bytes / 2;
+			for (unsigned k = 0; k < nlevels; ++k) {
+				levels[k] = rh_db16(map + k * 2);
+			}
+			int error = sweet_rpmh_arc_choose_level(levels, nlevels,
+			    requested, selector);
+			if (error) {
+				printf("SWEET RPMH: no safe ARC selector for %s level=%u\n",
+				    res, requested);
+				return error;
+			}
+			*address = addr;
+			printf("SWEET RPMH: ARC %s addr=%#x level=%u selector=%u\n",
+			    res, addr, requested, *selector);
+		}
+	}
+	if (matches != 1) {
+		printf("SWEET RPMH: ARC %s lookup matches=%u; refusing\n", res, matches);
+		return ENODEV;
+	}
+	return 0;
+}
