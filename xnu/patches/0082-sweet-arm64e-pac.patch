diff --git a/bsd/dev/arm/kern_machdep.c b/bsd/dev/arm/kern_machdep.c
--- a/bsd/dev/arm/kern_machdep.c
+++ b/bsd/dev/arm/kern_machdep.c
@@ -79,6 +79,22 @@
 	cpu_subtype_t hostsubtype = cpu_subtype();
 #endif /* __arm64__ */
 
+#if defined(SWEET)
+	/*
+	 * sweet implements no pointer authentication (ARMv8.2-A), so its
+	 * cpu_subtype() is never CPU_SUBTYPE_ARM64E and the switch below would
+	 * reject every arm64e slice with EBADARCH.  The iOS 17+ userland is
+	 * arm64e-only and the PAC instructions it executes are emulated as
+	 * no-ops in the unknown-instruction handler
+	 * (osfmk/arm64/sweet_pac.c), so accept the slice.  Grade 11 is the
+	 * "future ABI, run it like an arm64 slice" grade, chosen so a fat binary
+	 * carrying both slices prefers the arm64e one, as on real hardware.
+	 */
+	if (exectype == CPU_TYPE_ARM64 && execsubtype == CPU_SUBTYPE_ARM64E) {
+		return 11;
+	}
+#endif /* SWEET */
+
 	switch (exectype) {
 #if __arm64__
 	case CPU_TYPE_ARM64:
